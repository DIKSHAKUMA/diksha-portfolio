# GraphQL endpoint for Hygraph CMS (server-side only)
# Get this from your Hygraph project settings
NUXT_GQL_HOST=https://your-region.cdn.hygraph.com/content/your-project-id/master

# OpenWeather API key for weather widget
# Get this from https://openweathermap.org/api
NUXT_OPEN_WEATHER_API_KEY=your_openweather_api_key_here
